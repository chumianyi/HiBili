<phone:PhoneApplicationPage
    x:Class="HiBili.WP.Views.LoginPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:phone="clr-namespace:Microsoft.Phone.Controls;assembly=Microsoft.Phone"
    xmlns:shell="clr-namespace:Microsoft.Phone.Shell;assembly=Microsoft.Phone"
    xmlns:controls="clr-namespace:Microsoft.Phone.Controls;assembly=Microsoft.Phone"
    FontFamily="{StaticResource PhoneFontFamilyNormal}"
    FontSize="{StaticResource PhoneFontSizeNormal}"
    Foreground="{StaticResource PhoneForegroundBrush}"
    SupportedOrientations="Portrait" Orientation="Portrait"
    shell:SystemTray.IsVisible="True">

    <Grid Background="{StaticResource PageBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Title bar -->
        <Border Grid.Row="0" Background="{StaticResource TitleBarBrush}" Padding="16,10">
            <TextBlock Text="登录 Hi！Bili"
                       FontFamily="Segoe UI Light" FontSize="30"
                       Foreground="#FFFFFF" />
        </Border>

        <controls:Pivot Grid.Row="1"
                         Title=""
                         Foreground="#90CAF9"
                         Background="Transparent">

            <!-- ===== Tab 1: QR scan ===== -->
            <controls:PivotItem Header="扫码登录">
                <ScrollViewer>
                    <StackPanel Margin="12,18,12,0">
                        <TextBlock Text="打开哔哩哔哩手机客户端扫描二维码"
                                   Style="{StaticResource SubtitleText}"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,14" />

                        <Border Background="#FFFFFF" Padding="12"
                                HorizontalAlignment="Center"
                                BorderBrush="{StaticResource PhoneAccentBrush}" BorderThickness="2">
                            <Image x:Name="QrImage" Width="300" Height="300" />
                        </Border>

                        <TextBlock x:Name="QrStatusText"
                                   Text="正在获取二维码…"
                                   Style="{StaticResource SubtitleText}"
                                   HorizontalAlignment="Center"
                                   Margin="0,14,0,0" />

                        <Button Content="刷新二维码"
                                Style="{StaticResource BlueButtonStyle}"
                                HorizontalAlignment="Center"
                                Margin="0,18,0,0"
                                Click="RefreshQr_Click" />
                    </StackPanel>
                </ScrollViewer>
            </controls:PivotItem>

            <!-- ===== Tab 2: password ===== -->
            <controls:PivotItem Header="密码登录">
                <ScrollViewer>
                    <StackPanel Margin="12,18,12,0">
                        <TextBlock Text="账号"
                                   Style="{StaticResource SubtitleText}" Margin="0,0,0,4" />
                        <TextBox x:Name="UsernameBox"
                                 InputScope="EmailSmtpAddress"
                                 Background="#16283F" Foreground="#FFFFFF"
                                 BorderBrush="{StaticResource DividerBrush}" />

                        <TextBlock Text="密码"
                                   Style="{StaticResource SubtitleText}" Margin="0,14,0,4" />
                        <PasswordBox x:Name="PasswordBox"
                                     Background="#16283F" Foreground="#FFFFFF"
                                     BorderBrush="{StaticResource DividerBrush}" />

                        <TextBlock x:Name="PasswordErrorText"
                                   Text="" Foreground="#FF8A80"
                                   TextWrapping="Wrap" Margin="0,10,0,0" />

                        <Button x:Name="LoginButton"
                                Content="登录"
                                Style="{StaticResource BlueButtonStyle}"
                                Margin="0,20,0,0"
                                Click="LoginButton_Click" />
                    </StackPanel>
                </ScrollViewer>
            </controls:PivotItem>
        </controls:Pivot>
    </Grid>

</phone:PhoneApplicationPage>
