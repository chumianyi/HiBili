<phone:PhoneApplicationPage
    x:Class="HiBili.WP.Views.AboutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:phone="clr-namespace:Microsoft.Phone.Controls;assembly=Microsoft.Phone"
    xmlns:shell="clr-namespace:Microsoft.Phone.Shell;assembly=Microsoft.Phone"
    FontFamily="{StaticResource PhoneFontFamilyNormal}"
    FontSize="{StaticResource PhoneFontSizeNormal}"
    Foreground="{StaticResource PhoneForegroundBrush}"
    SupportedOrientations="Portrait" Orientation="Portrait"
    shell:SystemTray.IsVisible="True">

    <Grid Background="{StaticResource PageBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource TitleBarBrush}" Padding="16,10">
            <TextBlock Text="关于" FontFamily="Segoe UI Light" FontSize="30" Foreground="#FFFFFF" />
        </Border>

        <ScrollViewer Grid.Row="1" Margin="18,18,18,0">
            <StackPanel>
                <Image Source="/Assets/ApplicationIcon.png"
                       Width="100" Height="100"
                       HorizontalAlignment="Center" />
                <TextBlock Text="Hi！Bili"
                           Style="{StaticResource LightTitleText}"
                           HorizontalAlignment="Center"
                           Margin="0,12,0,0" />
                <TextBlock Text="版本 1.0.0.0（Windows Phone 参考版本）"
                           Style="{StaticResource SubtitleText}"
                           HorizontalAlignment="Center" />

                <TextBlock TextWrapping="Wrap"
                           Foreground="#E3F2FD"
                           Margin="0,24,0,0"
                           LineHeight="26">
                    <Run Text="GitHub: " Foreground="#90CAF9" />
                    <Run Text="https://github.com/chumianyi/HiBili" />
                </TextBlock>

                <TextBlock Text="本程序为自由软件，依据 GNU GPL v3.0 协议发布。"
                           TextWrapping="Wrap"
                           Foreground="#E3F2FD"
                           Margin="0,16,0,0" />

                <Border Background="#16283F" Padding="12" Margin="0,20,0,0"
                        BorderBrush="{StaticResource DividerBrush}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="致谢" Foreground="#90CAF9" FontWeight="Bold" />
                        <TextBlock TextWrapping="Wrap"
                                   Foreground="#E3F2FD"
                                   Margin="0,6,0,0">
                            <Run Text="感谢 PiliPlus " />
                            <Run Text="(https://github.com/bggRGjQaUbCoE/PiliPlus)" Foreground="#90CAF9" />
                        </TextBlock>
                    </StackPanel>
                </Border>

                <Button Content="退出登录"
                        Style="{StaticResource BlueButtonStyle}"
                        Margin="0,28,0,0"
                        Click="LogoutButton_Click" />
            </StackPanel>
        </ScrollViewer>
    </Grid>

</phone:PhoneApplicationPage>
