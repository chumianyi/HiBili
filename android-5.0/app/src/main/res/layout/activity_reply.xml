<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_page">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@color/miuix_primary"
        android:gravity="center_vertical"
        android:paddingLeft="16dp"
        android:paddingRight="16dp">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/reply_hint_content"
            android:textColor="@color/text_on_primary"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>

    <EditText
        android:id="@+id/et_bvid"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/padding_page"
        android:hint="@string/reply_hint_bvid"
        android:inputType="text"
        style="@style/Miuix.Input" />

    <EditText
        android:id="@+id/et_message"
        android:layout_width="match_parent"
        android:layout_height="180dp"
        android:layout_marginLeft="@dimen/padding_page"
        android:layout_marginRight="@dimen/padding_page"
        android:layout_marginBottom="@dimen/padding_page"
        android:gravity="top"
        android:hint="@string/reply_hint_content"
        android:inputType="textMultiLine|textCapSentences"
        style="@style/Miuix.Input" />

    <Button
        android:id="@+id/btn_send"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/padding_page"
        android:text="@string/action_publish"
        style="@style/Miuix.PrimaryButton" />

</LinearLayout>
