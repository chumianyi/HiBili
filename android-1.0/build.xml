<project name="HiBili" default="help">

    <!-- 本地 SDK 路径，CI 中由环境变量 ANDROID_HOME 提供 -->
    <property file="local.properties" />

    <!-- 导入 Android Ant 构建规则（debug / release / install 等 target） -->
    <import file="${sdk.dir}/tools/ant/build.xml" />

    <!-- 自定义清理：清除 Ant 中间产物 -->
    <target name="clean-hibili" depends="clean">
        <echo message="Hi！Bili reference build cleaned." />
    </target>

</project>
