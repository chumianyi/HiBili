<resources>
    <!--
      第一代 Android 蓝色主题。
      以 API 1 即存在的 Theme.Light 为父主题，
      仅覆盖 windowBackground 与基础文字外观，避免引用高版本属性。
      标题栏蓝色渐变通过各布局顶部的自定义 View 实现，保证兼容性。
    -->
    <style name="HiBiliTheme" parent="@android:style/Theme.Light">
        <item name="android:windowBackground">@drawable/bg_root</item>
        <item name="android:textColor">@color/text_dark</item>
        <item name="android:textSize">14sp</item>
    </style>
</resources>
